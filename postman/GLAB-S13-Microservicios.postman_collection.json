{
  "info": {
    "name": "GLAB-S13 — Service Discovery y API Gateway",
    "description": "Todas las peticiones pasan por el API Gateway (Spring Cloud Gateway 5, WebFlux) en http://localhost:8080. Requiere eureka-server (8761), categoria (8082), producto (8083), cliente (8081) y pedido (8084) levantados y registrados. La carpeta 05 incluye un caso que exige detener producto-service a proposito.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "eurekaUrl", "value": "http://localhost:8761" },
    { "key": "categoriaId", "value": "1" },
    { "key": "productoId", "value": "1" },
    { "key": "clienteId", "value": "6" },
    { "key": "pedidoId", "value": "1" },
    { "key": "pedidoAnularId", "value": "2" },
    { "key": "categoriaUtf8Id", "value": "9" }
  ],
  "item": [
    {
      "name": "00 — Eureka y rutas del gateway",
      "item": [
        {
          "name": "Eureka: aplicaciones registradas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('GATEWAY-SERVICE registrado', () => pm.expect(pm.response.text()).to.include('GATEWAY-SERVICE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{eurekaUrl}}/eureka/apps",
              "host": ["{{eurekaUrl}}"],
              "path": ["eureka", "apps"]
            }
          }
        },
        {
          "name": "Gateway: health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Gateway: rutas definidas (actuator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rutas = pm.response.json();",
                  "pm.test('incluye las 4 rutas explicitas', () => { const ids = rutas.map(r => r.route_id); ['categoria-service','producto-service','cliente-service','pedido-service'].forEach(id => pm.expect(ids).to.include(id)); });",
                  "pm.test('el discovery locator agrega una ruta por servicio registrado', () => pm.expect(rutas.length).to.be.at.least(8));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/gateway/routes",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "gateway", "routes"]
            }
          }
        }
      ]
    },
